{"Mode":"Backup","Version":"5.1.100","SystemCode":"ERP","LibraryId":"CallLib","Library":{"OriginalID":"CallLib","Description":"A modern take on Epicor dynamic dispatch.","GlobalID":"c5ccb4c1-78d4-5371-8e13-10833f63ecd6","EpicorVersion":"5.1.100","Revision":1,"Published":false,"Private":false,"Disabled":false,"Mode":0,"AllowCustomCodeWidgets":false,"AllowCustomCodeFunctions":true,"DirectDBAccess":0,"OwnedByCompany":"CALLDEMO","Owner":"KLINCECUM","SharedWithGroup":"","Notes":"A modern take on Epicor dynamic dispatch. Based on FunctionRunner.\n\nMIT License\n\nCopyright (c) 2026 Kevin P. Lincecum\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in\nall copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN\nTHE SOFTWARE.\n","Functions":[{"FunctionID":"Get","Description":"Get reusable calling methods for this request.","Kind":2,"RequireTransaction":false,"SingleRowMode":false,"Private":false,"Disabled":false,"Invalid":false,"Thumbnail":null,"Notes":"Get reusable calling methods for this request.","FunctionSignature":[{"Response":false,"ParameterID":1,"ArgumentName":"iErrorMode","Order":1,"DataType":"System.String","Optional":false,"Description":""},{"Response":true,"ParameterID":1,"ArgumentName":"oMethods","Order":1,"DataType":"System.Data.DataSet","Optional":false,"Description":""}],"Body":"{\"Code\": \"// Copyright (c) 2026 Kevin P. Lincecum\\n// SPDX-License-Identifier: MIT\\n\\n// Get gives the caller two methods to reuse during this request.\\n// Both remember the chosen error mode; each call gets its own result and details.\\n// Delegates capture this request's host. Do not cache them across requests.\\n// Each call gets one small record explaining what happened. Do not put input/output objects here.\\nDataSet NewDetails(string library, string function)\\n{\\n    var details = new DataSet(\\\"CallDetails\\\");\\n    var table = details.Tables.Add(\\\"Call\\\");\\n    table.Columns.Add(\\\"Id\\\", typeof(string));\\n    table.Columns.Add(\\\"Library\\\", typeof(string));\\n    table.Columns.Add(\\\"Function\\\", typeof(string));\\n    table.Columns.Add(\\\"Stage\\\", typeof(string));\\n    table.Columns.Add(\\\"Status\\\", typeof(string));\\n    table.Columns.Add(\\\"DispatchStarted\\\", typeof(bool));\\n    table.Columns.Add(\\\"ElapsedMilliseconds\\\", typeof(long));\\n    table.Columns.Add(\\\"ErrorCode\\\", typeof(string));\\n    table.Columns.Add(\\\"Message\\\", typeof(string));\\n    table.Rows.Add(Guid.NewGuid().ToString(\\\"N\\\"), library ?? \\\"\\\", function ?? \\\"\\\", \\\"Validate\\\", \\\"NotStarted\\\", false, 0L, \\\"\\\", \\\"\\\");\\n    return details;\\n}\\n\\nvoid Failure(DataSet details, string status, string code, string message)\\n{\\n    var row = details.Tables[\\\"Call\\\"].Rows[0];\\n    row[\\\"Status\\\"] = status;\\n    row[\\\"ErrorCode\\\"] = code;\\n    row[\\\"Message\\\"] = message;\\n}\\n\\n// Require an explicit choice so a typo cannot silently change error handling.\\nbool ThrowErrors(string mode)\\n{\\n    if (mode == \\\"Throw\\\") return true;\\n    if (mode == \\\"Return\\\") return false;\\n    throw new Ice.BLException(\\\"Error mode must be Throw or Return.\\\");\\n}\\n\\n// Include the call ID in the message so a caller can match the exception to its details.\\n// Exception.Data is useful inside the server, but is not promised to survive REST.\\nvoid RaiseFailure(DataSet details)\\n{\\n    var row = details.Tables[\\\"Call\\\"].Rows[0];\\n    var error = new Ice.BLException(Convert.ToString(row[\\\"ErrorCode\\\"]) + \\\": \\\" + Convert.ToString(row[\\\"Message\\\"]) + \\\" [Call \\\" + Convert.ToString(row[\\\"Id\\\"]) + \\\"]\\\");\\n    error.Data[\\\"CallDetails\\\"] = details;\\n    throw error;\\n}\\n\\nvar throwErrors = ThrowErrors(iErrorMode);\\n\\nFunc<string, string, object[], (bool Success, object[] Outputs, DataSet Details)> run = (library, function, arguments) =>\\n{\\n    var watch = System.Diagnostics.Stopwatch.StartNew();\\n    var details = NewDetails(library, function);\\n    var row = details.Tables[\\\"Call\\\"].Rows[0];\\n    var outputs = Array.Empty<object>();\\n    var success = false;\\n    if (String.IsNullOrWhiteSpace(library) || String.IsNullOrWhiteSpace(function) || arguments == null)\\n    {\\n        Failure(details, \\\"NotStarted\\\", \\\"InvalidRequest\\\", \\\"Provide a library, a Function and an argument array. Use an empty array for no arguments.\\\");\\n    }\\n    else\\n    {\\n        row[\\\"Stage\\\"] = \\\"Dispatch\\\";\\n        try\\n        {\\n            CallService<Ice.Contracts.DynamicQuerySvcContract>(service =>\\n            {\\n                // This extra object column carries the actual objects to the UBAQ. Nothing is JSON here.\\n                var parameters = new Ice.Tablesets.QueryExecutionTableset();\\n                parameters.ExecutionParameter.Columns.Add(IceColumn.Create(\\\"Value\\\", typeof(object)));\\n                var request = (Ice.Tablesets.ExecutionParameterRow)parameters.ExecutionParameter.NewRow();\\n                request.ParameterID = \\\"Request\\\";\\n                request.ParameterValue = \\\"1\\\";\\n                request[\\\"Value\\\"] = new object[] { library, function, arguments };\\n                parameters.ExecutionParameter.Add(request);\\n                // Reserve a place for outputs, even when the target returns nothing.\\n                var result = (Ice.Tablesets.ExecutionParameterRow)parameters.ExecutionParameter.NewRow();\\n                result.ParameterID = \\\"Result\\\";\\n                result.ParameterValue = \\\"\\\";\\n                result[\\\"Value\\\"] = Array.Empty<object>();\\n                parameters.ExecutionParameter.Add(result);\\n                // Share one details object so the UBAQ can tell us how the call ended.\\n                var status = (Ice.Tablesets.ExecutionParameterRow)parameters.ExecutionParameter.NewRow();\\n                status.ParameterID = \\\"Details\\\";\\n                status.ParameterValue = \\\"\\\";\\n                status[\\\"Value\\\"] = details;\\n                parameters.ExecutionParameter.Add(status);\\n\\n                // Execute once. A returned query is not enough: the UBAQ must acknowledge the call.\\n                // Check the original details object so a replacement cannot fake completion.\\n                service.ExecuteByID(\\\"CallUBAQ\\\", parameters);\\n                var state = Convert.ToString(row[\\\"Status\\\"]);\\n                if (status.ParameterValue != \\\"1\\\" || !ReferenceEquals(status[\\\"Value\\\"], details) ||\\n                    (state != \\\"Succeeded\\\" && state != \\\"Failed\\\"))\\n                {\\n                    row[\\\"DispatchStarted\\\"] = DBNull.Value;\\n                    Failure(details, \\\"Unknown\\\", \\\"BridgeUnavailable\\\", \\\"The Call query did not return a complete response. The call was not repeated.\\\");\\n                }\\n                else if (state == \\\"Succeeded\\\" && result[\\\"Value\\\"] is object[] values)\\n                {\\n                    outputs = values;\\n                    success = true;\\n                }\\n                else if (state == \\\"Succeeded\\\")\\n                {\\n                    Failure(details, \\\"Unknown\\\", \\\"OutcomeUnknown\\\", \\\"The Call query returned an invalid output array. The call was not repeated.\\\");\\n                }\\n            });\\n        }\\n        catch (Exception error)\\n        {\\n            // The target may already have done its work. Do not automatically call it again.\\n            row[\\\"DispatchStarted\\\"] = DBNull.Value;\\n            var message = error.Message ?? \\\"The transport failed.\\\";\\n            Failure(details, \\\"Unknown\\\", \\\"OutcomeUnknown\\\", \\\"The Call query did not finish normally: \\\" + message + \\\" Check the target before repeating this call.\\\");\\n            success = false;\\n            outputs = Array.Empty<object>();\\n        }\\n    }\\n    watch.Stop();\\n    row[\\\"ElapsedMilliseconds\\\"] = watch.ElapsedMilliseconds;\\n    if (!success && throwErrors) RaiseFailure(details);\\n    return (success, outputs, details);\\n};\\n\\nFunc<string, string, object, (bool Success, object[] Outputs, DataSet Details)> packed = (library, function, value) =>\\n{\\n    // Bare null means no inputs. To pass one null input, use new object[] { null }.\\n    if (value == null) return run(library, function, Array.Empty<object>());\\n    if (value is object[] array) return run(library, function, array);\\n    if (value is System.Runtime.CompilerServices.ITuple tuple)\\n    {\\n        var arguments = new object[tuple.Length];\\n        for (var i = 0; i < arguments.Length; i++) arguments[i] = tuple[i];\\n        return run(library, function, arguments);\\n    }\\n    return run(library, function, new object[] { value });\\n};\\n\\n// A DataSet can carry these delegates between server Functions during this request.\\n// UseCall reads this table and checks that its version and delegate types match.\\noMethods = new DataSet(\\\"CallMethods\\\");\\nvar methods = oMethods.Tables.Add(\\\"Methods\\\");\\nmethods.Columns.Add(\\\"Version\\\", typeof(int));\\nmethods.Columns.Add(\\\"Run\\\", typeof(object));\\nmethods.Columns.Add(\\\"Packed\\\", typeof(object));\\nmethods.Rows.Add(1, run, packed);\\n\", \"Usings\": \"using System;\\nusing System.Data;\\nusing System.Collections.Generic;\\nusing System.Linq;\"}"},{"FunctionID":"Call","Description":"Call a Function with an ordered array of real objects.","Kind":2,"RequireTransaction":false,"SingleRowMode":false,"Private":false,"Disabled":false,"Invalid":false,"Thumbnail":null,"Notes":"Call a Function with an ordered array of real objects.","FunctionSignature":[{"Response":false,"ParameterID":1,"ArgumentName":"iLibrary","Order":1,"DataType":"System.String","Optional":false,"Description":""},{"Response":false,"ParameterID":2,"ArgumentName":"iFunction","Order":2,"DataType":"System.String","Optional":false,"Description":""},{"Response":false,"ParameterID":3,"ArgumentName":"iArguments","Order":3,"DataType":"System.Object[]","Optional":false,"Description":"","DataTypeInfo":"{\"wellknownType\":5,\"namespace\":\"System\",\"name\":\"Object[]\",\"options\":0,\"elementType\":{\"wellknownType\":0,\"namespace\":\"System\",\"name\":\"Object\",\"options\":2}}"},{"Response":false,"ParameterID":4,"ArgumentName":"iErrorMode","Order":4,"DataType":"System.String","Optional":false,"Description":""},{"Response":true,"ParameterID":1,"ArgumentName":"oSuccess","Order":1,"DataType":"System.Boolean","Optional":false,"Description":""},{"Response":true,"ParameterID":2,"ArgumentName":"oOutputs","Order":2,"DataType":"System.Object[]","Optional":false,"Description":"","DataTypeInfo":"{\"wellknownType\":5,\"namespace\":\"System\",\"name\":\"Object[]\",\"options\":0,\"elementType\":{\"wellknownType\":0,\"namespace\":\"System\",\"name\":\"Object\",\"options\":2}}"},{"Response":true,"ParameterID":3,"ArgumentName":"oDetails","Order":3,"DataType":"System.Data.DataSet","Optional":false,"Description":""}],"Body":"{\"Code\": \"// Copyright (c) 2026 Kevin P. Lincecum\\n// SPDX-License-Identifier: MIT\\n\\n// Make one call. Get supplies the same calling method used by repeat callers.\\n// Paste this helper inside a consuming Function. It turns Get's DataSet into named, typed methods.\\n// Validate the table before casting so incompatible versions fail with a useful message.\\n(Func<string, string, object[], (bool Success, object[] Outputs, DataSet Details)> Run,\\n Func<string, string, object, (bool Success, object[] Outputs, DataSet Details)> Packed) UseCall(Func<DataSet> acquire)\\n{\\n    if (acquire == null) throw new ArgumentNullException(nameof(acquire));\\n    var carrier = acquire();\\n    if (carrier == null || carrier.Tables.Count != 1 || !carrier.Tables.Contains(\\\"Methods\\\"))\\n        throw new Ice.BLException(\\\"Call did not return its methods.\\\");\\n    // Validate the carrier before casting delegates from a separately compiled library.\\n    var table = carrier.Tables[\\\"Methods\\\"];\\n    if (table.Rows.Count != 1 || table.Rows[0].RowState == DataRowState.Deleted ||\\n        !table.Columns.Contains(\\\"Version\\\") || table.Columns[\\\"Version\\\"].DataType != typeof(int) ||\\n        !table.Columns.Contains(\\\"Run\\\") || !table.Columns.Contains(\\\"Packed\\\"))\\n        throw new Ice.BLException(\\\"Call returned an invalid methods table.\\\");\\n    var row = table.Rows[0];\\n    if (!(row[\\\"Version\\\"] is int version) || version != 1)\\n        throw new Ice.BLException(\\\"This consumer requires Call contract 1.\\\");\\n    var run = row[\\\"Run\\\"] as Func<string, string, object[], (bool Success, object[] Outputs, DataSet Details)>;\\n    var packed = row[\\\"Packed\\\"] as Func<string, string, object, (bool Success, object[] Outputs, DataSet Details)>;\\n    if (run == null || packed == null) throw new Ice.BLException(\\\"Call returned incompatible method types.\\\");\\n    return (run, packed);\\n}\\n\\nvar call = UseCall(() => ThisLib.Get(iErrorMode));\\nvar result = call.Run(iLibrary, iFunction, iArguments);\\n// Return the outcome, values and explanation to the calling Function.\\noSuccess = result.Success;\\noOutputs = result.Outputs;\\noDetails = result.Details;\\n\", \"Usings\": \"using System;\\nusing System.Data;\\nusing System.Collections.Generic;\\nusing System.Linq;\"}"},{"FunctionID":"Packed","Description":"Call a Function using a scalar, tuple or argument array.","Kind":2,"RequireTransaction":false,"SingleRowMode":false,"Private":false,"Disabled":false,"Invalid":false,"Thumbnail":null,"Notes":"Call a Function using a scalar, tuple or argument array.","FunctionSignature":[{"Response":false,"ParameterID":1,"ArgumentName":"iLibrary","Order":1,"DataType":"System.String","Optional":false,"Description":""},{"Response":false,"ParameterID":2,"ArgumentName":"iFunction","Order":2,"DataType":"System.String","Optional":false,"Description":""},{"Response":false,"ParameterID":3,"ArgumentName":"iArguments","Order":3,"DataType":"System.Object","Optional":false,"Description":"","DataTypeInfo":"{\"wellknownType\":0,\"namespace\":\"System\",\"name\":\"Object\",\"options\":2}"},{"Response":false,"ParameterID":4,"ArgumentName":"iErrorMode","Order":4,"DataType":"System.String","Optional":false,"Description":""},{"Response":true,"ParameterID":1,"ArgumentName":"oSuccess","Order":1,"DataType":"System.Boolean","Optional":false,"Description":""},{"Response":true,"ParameterID":2,"ArgumentName":"oOutputs","Order":2,"DataType":"System.Object[]","Optional":false,"Description":"","DataTypeInfo":"{\"wellknownType\":5,\"namespace\":\"System\",\"name\":\"Object[]\",\"options\":0,\"elementType\":{\"wellknownType\":0,\"namespace\":\"System\",\"name\":\"Object\",\"options\":2}}"},{"Response":true,"ParameterID":3,"ArgumentName":"oDetails","Order":3,"DataType":"System.Data.DataSet","Optional":false,"Description":""}],"Body":"{\"Code\": \"// Copyright (c) 2026 Kevin P. Lincecum\\n// SPDX-License-Identifier: MIT\\n\\n// Accept a scalar or tuple, then use the same dispatcher as an argument-array call.\\n// Paste this helper inside a consuming Function. It turns Get's DataSet into named, typed methods.\\n// Validate the table before casting so incompatible versions fail with a useful message.\\n(Func<string, string, object[], (bool Success, object[] Outputs, DataSet Details)> Run,\\n Func<string, string, object, (bool Success, object[] Outputs, DataSet Details)> Packed) UseCall(Func<DataSet> acquire)\\n{\\n    if (acquire == null) throw new ArgumentNullException(nameof(acquire));\\n    var carrier = acquire();\\n    if (carrier == null || carrier.Tables.Count != 1 || !carrier.Tables.Contains(\\\"Methods\\\"))\\n        throw new Ice.BLException(\\\"Call did not return its methods.\\\");\\n    // Validate the carrier before casting delegates from a separately compiled library.\\n    var table = carrier.Tables[\\\"Methods\\\"];\\n    if (table.Rows.Count != 1 || table.Rows[0].RowState == DataRowState.Deleted ||\\n        !table.Columns.Contains(\\\"Version\\\") || table.Columns[\\\"Version\\\"].DataType != typeof(int) ||\\n        !table.Columns.Contains(\\\"Run\\\") || !table.Columns.Contains(\\\"Packed\\\"))\\n        throw new Ice.BLException(\\\"Call returned an invalid methods table.\\\");\\n    var row = table.Rows[0];\\n    if (!(row[\\\"Version\\\"] is int version) || version != 1)\\n        throw new Ice.BLException(\\\"This consumer requires Call contract 1.\\\");\\n    var run = row[\\\"Run\\\"] as Func<string, string, object[], (bool Success, object[] Outputs, DataSet Details)>;\\n    var packed = row[\\\"Packed\\\"] as Func<string, string, object, (bool Success, object[] Outputs, DataSet Details)>;\\n    if (run == null || packed == null) throw new Ice.BLException(\\\"Call returned incompatible method types.\\\");\\n    return (run, packed);\\n}\\n\\nvar call = UseCall(() => ThisLib.Get(iErrorMode));\\nvar result = call.Packed(iLibrary, iFunction, iArguments);\\noSuccess = result.Success;\\noOutputs = result.Outputs;\\noDetails = result.Details;\\n\", \"Usings\": \"using System;\\nusing System.Data;\\nusing System.Collections.Generic;\\nusing System.Linq;\"}"},{"FunctionID":"Rest","Description":"Call a Function using a JSON argument array.","Kind":2,"RequireTransaction":false,"SingleRowMode":false,"Private":false,"Disabled":false,"Invalid":false,"Thumbnail":null,"Notes":"Call a Function using a JSON argument array.","FunctionSignature":[{"Response":false,"ParameterID":1,"ArgumentName":"iLibrary","Order":1,"DataType":"System.String","Optional":false,"Description":""},{"Response":false,"ParameterID":2,"ArgumentName":"iFunction","Order":2,"DataType":"System.String","Optional":false,"Description":""},{"Response":false,"ParameterID":3,"ArgumentName":"iArguments","Order":3,"DataType":"System.String","Optional":false,"Description":""},{"Response":false,"ParameterID":4,"ArgumentName":"iErrorMode","Order":4,"DataType":"System.String","Optional":false,"Description":""},{"Response":true,"ParameterID":1,"ArgumentName":"oSuccess","Order":1,"DataType":"System.Boolean","Optional":false,"Description":""},{"Response":true,"ParameterID":2,"ArgumentName":"oOutputs","Order":2,"DataType":"System.Data.DataSet","Optional":false,"Description":""},{"Response":true,"ParameterID":3,"ArgumentName":"oDetails","Order":3,"DataType":"System.Data.DataSet","Optional":false,"Description":""}],"Body":"{\"Code\": \"// Copyright (c) 2026 Kevin P. Lincecum\\n// SPDX-License-Identifier: MIT\\n\\n// Read the JSON arguments in their supplied order. RestCore does the conversion and call.\\n(oSuccess, oOutputs, oDetails) = ThisLib.RestCore(iLibrary, iFunction, iArguments, false, iErrorMode);\\n\", \"Usings\": \"using System;\\nusing System.Data;\\nusing System.Collections.Generic;\\nusing System.Linq;\"}"},{"FunctionID":"RestNamed","Description":"Call a Function using named JSON arguments.","Kind":2,"RequireTransaction":false,"SingleRowMode":false,"Private":false,"Disabled":false,"Invalid":false,"Thumbnail":null,"Notes":"Call a Function using named JSON arguments.","FunctionSignature":[{"Response":false,"ParameterID":1,"ArgumentName":"iLibrary","Order":1,"DataType":"System.String","Optional":false,"Description":""},{"Response":false,"ParameterID":2,"ArgumentName":"iFunction","Order":2,"DataType":"System.String","Optional":false,"Description":""},{"Response":false,"ParameterID":3,"ArgumentName":"iArguments","Order":3,"DataType":"System.String","Optional":false,"Description":""},{"Response":false,"ParameterID":4,"ArgumentName":"iErrorMode","Order":4,"DataType":"System.String","Optional":false,"Description":""},{"Response":true,"ParameterID":1,"ArgumentName":"oSuccess","Order":1,"DataType":"System.Boolean","Optional":false,"Description":""},{"Response":true,"ParameterID":2,"ArgumentName":"oOutputs","Order":2,"DataType":"System.Data.DataSet","Optional":false,"Description":""},{"Response":true,"ParameterID":3,"ArgumentName":"oDetails","Order":3,"DataType":"System.Data.DataSet","Optional":false,"Description":""}],"Body":"{\"Code\": \"// Copyright (c) 2026 Kevin P. Lincecum\\n// SPDX-License-Identifier: MIT\\n\\n// Match JSON properties to the target input names. Their order does not matter.\\n(oSuccess, oOutputs, oDetails) = ThisLib.RestCore(iLibrary, iFunction, iArguments, true, iErrorMode);\\n\", \"Usings\": \"using System;\\nusing System.Data;\\nusing System.Collections.Generic;\\nusing System.Linq;\"}"},{"FunctionID":"RestCore","Description":"Shared JSON binding and result projection.","Kind":2,"RequireTransaction":false,"SingleRowMode":false,"Private":true,"Disabled":false,"Invalid":false,"Thumbnail":null,"Notes":"Shared JSON binding and result projection.","FunctionSignature":[{"Response":false,"ParameterID":1,"ArgumentName":"iLibrary","Order":1,"DataType":"System.String","Optional":false,"Description":""},{"Response":false,"ParameterID":2,"ArgumentName":"iFunction","Order":2,"DataType":"System.String","Optional":false,"Description":""},{"Response":false,"ParameterID":3,"ArgumentName":"iArguments","Order":3,"DataType":"System.String","Optional":false,"Description":""},{"Response":false,"ParameterID":4,"ArgumentName":"iNamed","Order":4,"DataType":"System.Boolean","Optional":false,"Description":""},{"Response":false,"ParameterID":5,"ArgumentName":"iErrorMode","Order":5,"DataType":"System.String","Optional":false,"Description":""},{"Response":true,"ParameterID":1,"ArgumentName":"oSuccess","Order":1,"DataType":"System.Boolean","Optional":false,"Description":""},{"Response":true,"ParameterID":2,"ArgumentName":"oOutputs","Order":2,"DataType":"System.Data.DataSet","Optional":false,"Description":""},{"Response":true,"ParameterID":3,"ArgumentName":"oDetails","Order":3,"DataType":"System.Data.DataSet","Optional":false,"Description":""}],"Body":"{\"Code\": \"// Copyright (c) 2026 Kevin P. Lincecum\\n// SPDX-License-Identifier: MIT\\n\\n// Turn JSON into the target's declared input types, then use the normal server caller.\\n// Positional and named REST requests share this code so their behavior stays the same.\\n// Each call gets one small record explaining what happened. Do not put input/output objects here.\\nDataSet NewDetails(string library, string function)\\n{\\n    var details = new DataSet(\\\"CallDetails\\\");\\n    var table = details.Tables.Add(\\\"Call\\\");\\n    table.Columns.Add(\\\"Id\\\", typeof(string));\\n    table.Columns.Add(\\\"Library\\\", typeof(string));\\n    table.Columns.Add(\\\"Function\\\", typeof(string));\\n    table.Columns.Add(\\\"Stage\\\", typeof(string));\\n    table.Columns.Add(\\\"Status\\\", typeof(string));\\n    table.Columns.Add(\\\"DispatchStarted\\\", typeof(bool));\\n    table.Columns.Add(\\\"ElapsedMilliseconds\\\", typeof(long));\\n    table.Columns.Add(\\\"ErrorCode\\\", typeof(string));\\n    table.Columns.Add(\\\"Message\\\", typeof(string));\\n    table.Rows.Add(Guid.NewGuid().ToString(\\\"N\\\"), library ?? \\\"\\\", function ?? \\\"\\\", \\\"Validate\\\", \\\"NotStarted\\\", false, 0L, \\\"\\\", \\\"\\\");\\n    return details;\\n}\\n\\nvoid Failure(DataSet details, string status, string code, string message)\\n{\\n    var row = details.Tables[\\\"Call\\\"].Rows[0];\\n    row[\\\"Status\\\"] = status;\\n    row[\\\"ErrorCode\\\"] = code;\\n    row[\\\"Message\\\"] = message;\\n}\\n\\n// Require an explicit choice so a typo cannot silently change error handling.\\nbool ThrowErrors(string mode)\\n{\\n    if (mode == \\\"Throw\\\") return true;\\n    if (mode == \\\"Return\\\") return false;\\n    throw new Ice.BLException(\\\"Error mode must be Throw or Return.\\\");\\n}\\n\\n// Include the call ID in the message so a caller can match the exception to its details.\\n// Exception.Data is useful inside the server, but is not promised to survive REST.\\nvoid RaiseFailure(DataSet details)\\n{\\n    var row = details.Tables[\\\"Call\\\"].Rows[0];\\n    var error = new Ice.BLException(Convert.ToString(row[\\\"ErrorCode\\\"]) + \\\": \\\" + Convert.ToString(row[\\\"Message\\\"]) + \\\" [Call \\\" + Convert.ToString(row[\\\"Id\\\"]) + \\\"]\\\");\\n    error.Data[\\\"CallDetails\\\"] = details;\\n    throw error;\\n}\\n\\n// Paste this helper inside a consuming Function. It turns Get's DataSet into named, typed methods.\\n// Validate the table before casting so incompatible versions fail with a useful message.\\n(Func<string, string, object[], (bool Success, object[] Outputs, DataSet Details)> Run,\\n Func<string, string, object, (bool Success, object[] Outputs, DataSet Details)> Packed) UseCall(Func<DataSet> acquire)\\n{\\n    if (acquire == null) throw new ArgumentNullException(nameof(acquire));\\n    var carrier = acquire();\\n    if (carrier == null || carrier.Tables.Count != 1 || !carrier.Tables.Contains(\\\"Methods\\\"))\\n        throw new Ice.BLException(\\\"Call did not return its methods.\\\");\\n    // Validate the carrier before casting delegates from a separately compiled library.\\n    var table = carrier.Tables[\\\"Methods\\\"];\\n    if (table.Rows.Count != 1 || table.Rows[0].RowState == DataRowState.Deleted ||\\n        !table.Columns.Contains(\\\"Version\\\") || table.Columns[\\\"Version\\\"].DataType != typeof(int) ||\\n        !table.Columns.Contains(\\\"Run\\\") || !table.Columns.Contains(\\\"Packed\\\"))\\n        throw new Ice.BLException(\\\"Call returned an invalid methods table.\\\");\\n    var row = table.Rows[0];\\n    if (!(row[\\\"Version\\\"] is int version) || version != 1)\\n        throw new Ice.BLException(\\\"This consumer requires Call contract 1.\\\");\\n    var run = row[\\\"Run\\\"] as Func<string, string, object[], (bool Success, object[] Outputs, DataSet Details)>;\\n    var packed = row[\\\"Packed\\\"] as Func<string, string, object, (bool Success, object[] Outputs, DataSet Details)>;\\n    if (run == null || packed == null) throw new Ice.BLException(\\\"Call returned incompatible method types.\\\");\\n    return (run, packed);\\n}\\n\\nvar throwErrors = ThrowErrors(iErrorMode);\\nvar watch = System.Diagnostics.Stopwatch.StartNew();\\noSuccess = false;\\noDetails = NewDetails(iLibrary, iFunction);\\noOutputs = new DataSet(\\\"CallOutputs\\\");\\nvar outputTable = oOutputs.Tables.Add(\\\"Outputs\\\");\\noutputTable.Columns.Add(\\\"Index\\\", typeof(int));\\noutputTable.Columns.Add(\\\"Name\\\", typeof(string));\\noutputTable.Columns.Add(\\\"Value\\\", typeof(object));\\nvar stage = \\\"Validate\\\";\\nvar dispatched = false;\\n\\n// Reject duplicate JSON names instead of silently choosing one of their values.\\nvoid CheckProperties(System.Text.Json.JsonElement value)\\n{\\n    // Traverse with an explicit stack so validation does not impose a call-stack depth limit.\\n    var pending = new Stack<System.Text.Json.JsonElement>();\\n    pending.Push(value);\\n    while (pending.Count != 0)\\n    {\\n        var current = pending.Pop();\\n        if (current.ValueKind == System.Text.Json.JsonValueKind.Object)\\n        {\\n            var names = new HashSet<string>(StringComparer.Ordinal);\\n            foreach (var property in current.EnumerateObject())\\n            {\\n                if (!names.Add(property.Name)) throw new Ice.BLException(\\\"JSON contains a duplicate property name.\\\");\\n                pending.Push(property.Value);\\n            }\\n        }\\n        else if (current.ValueKind == System.Text.Json.JsonValueKind.Array)\\n        {\\n            foreach (var child in current.EnumerateArray()) pending.Push(child);\\n        }\\n    }\\n}\\n\\n// Trust the type declared by the server Function, never a type name supplied in JSON.\\nType InputType(DataRow parameter)\\n{\\n    var name = Convert.ToString(parameter[\\\"Type\\\"]).Trim();\\n    var nullable = name.EndsWith(\\\"?\\\", StringComparison.Ordinal);\\n    if (nullable) name = name.Substring(0, name.Length - 1);\\n    Type type = name == \\\"System.Data.DataSet\\\" ? typeof(DataSet) :\\n        name == \\\"System.Data.DataTable\\\" ? typeof(DataTable) : Type.GetType(name, false);\\n    if (type == null && !parameter.IsNull(\\\"TypeInfo\\\") &&\\n        !String.IsNullOrWhiteSpace(Convert.ToString(parameter[\\\"TypeInfo\\\"])))\\n    {\\n        var info = Newtonsoft.Json.Linq.JObject.Parse(Convert.ToString(parameter[\\\"TypeInfo\\\"]));\\n        var assembly = Convert.ToString(info[\\\"assembly\\\"]);\\n        if (!String.IsNullOrWhiteSpace(assembly)) type = Type.GetType(name + \\\", \\\" + assembly, false);\\n    }\\n    if (type == null) throw new Ice.BLException(\\\"The declared input type cannot be loaded in this server context.\\\");\\n    if (nullable) type = typeof(Nullable<>).MakeGenericType(type);\\n    return type;\\n}\\n\\ntry\\n{\\n    if (String.IsNullOrWhiteSpace(iLibrary) || String.IsNullOrWhiteSpace(iFunction))\\n        throw new Ice.BLException(\\\"Provide a library and a Function.\\\");\\n    if (String.IsNullOrWhiteSpace(iArguments))\\n        throw new Ice.BLException(iNamed\\n            ? \\\"Provide a JSON object; use {} for no arguments.\\\"\\n            : \\\"Provide a JSON array; use [] for no arguments.\\\");\\n    // Use the parser's representable depth range instead of a product-specific cap.\\n    // Available host memory and the native request pipeline still constrain workloads.\\n    using (var document = System.Text.Json.JsonDocument.Parse(iArguments, new System.Text.Json.JsonDocumentOptions { MaxDepth = Int32.MaxValue }))\\n    {\\n        var json = document.RootElement;\\n        var requiredKind = iNamed ? System.Text.Json.JsonValueKind.Object : System.Text.Json.JsonValueKind.Array;\\n        if (json.ValueKind != requiredKind)\\n            throw new Ice.BLException(iNamed ? \\\"Named arguments must be a JSON object.\\\" : \\\"Positional arguments must be a JSON array.\\\");\\n        CheckProperties(json);\\n        // Read fresh metadata for this call so changed Function signatures are not cached.\\n        stage = \\\"Lookup\\\";\\n        var signature = ThisLib.ReadSignature(iLibrary, iFunction).Tables[\\\"Signature\\\"];\\n        var inputs = signature.Rows.Cast<DataRow>()\\n            .Where(r => !Convert.ToBoolean(r[\\\"Response\\\"]))\\n            .OrderBy(r => Convert.ToInt32(r[\\\"Order\\\"]))\\n            .ToArray();\\n        var outputs = signature.Rows.Cast<DataRow>()\\n            .Where(r => Convert.ToBoolean(r[\\\"Response\\\"]))\\n            .OrderBy(r => Convert.ToInt32(r[\\\"Order\\\"]))\\n            .ToArray();\\n        stage = \\\"Bind\\\";\\n        var tokens = new System.Text.Json.JsonElement[inputs.Length];\\n        // Put both input styles into target parameter order before converting any values.\\n        if (iNamed)\\n        {\\n            var supplied = json.EnumerateObject().ToDictionary(p => p.Name, p => p.Value, StringComparer.Ordinal);\\n            var expected = new HashSet<string>(inputs.Select(r => Convert.ToString(r[\\\"Name\\\"])), StringComparer.Ordinal);\\n            if (supplied.Keys.Any(name => !expected.Contains(name)))\\n                throw new Ice.BLException(\\\"Named arguments contain an unknown parameter. Use the exact target parameter names.\\\");\\n            for (var i = 0; i < inputs.Length; i++)\\n            {\\n                var name = Convert.ToString(inputs[i][\\\"Name\\\"]);\\n                if (!supplied.TryGetValue(name, out tokens[i]))\\n                    throw new Ice.BLException(\\\"Missing argument '\\\" + name + \\\"'. Provide every declared input, including explicit nulls.\\\");\\n            }\\n        }\\n        else\\n        {\\n            if (json.GetArrayLength() != inputs.Length)\\n                throw new Ice.BLException(\\\"Expected \\\" + inputs.Length + \\\" arguments but received \\\" + json.GetArrayLength() + \\\".\\\");\\n            for (var i = 0; i < inputs.Length; i++) tokens[i] = json[i];\\n        }\\n        var arguments = new object[inputs.Length];\\n        for (var i = 0; i < inputs.Length; i++)\\n        {\\n            try\\n            {\\n                var type = InputType(inputs[i]);\\n                if (tokens[i].ValueKind == System.Text.Json.JsonValueKind.Null &&\\n                    type.IsValueType && Nullable.GetUnderlyingType(type) == null)\\n                    throw new Ice.BLException(\\\"Null is not valid for this value type.\\\");\\n                // Keep each original JSON value intact until its declared type is known.\\n                var settings = new Newtonsoft.Json.JsonSerializerSettings\\n                {\\n                    DateParseHandling = Newtonsoft.Json.DateParseHandling.None,\\n                    TypeNameHandling = Newtonsoft.Json.TypeNameHandling.None,\\n                    MetadataPropertyHandling = Newtonsoft.Json.MetadataPropertyHandling.Ignore,\\n                    MaxDepth = Int32.MaxValue,\\n                    Culture = System.Globalization.CultureInfo.InvariantCulture\\n                };\\n                arguments[i] = Newtonsoft.Json.JsonConvert.DeserializeObject(tokens[i].GetRawText(), type, settings);\\n            }\\n            catch (Exception)\\n            {\\n                throw new Ice.BLException(\\\"Argument \\\" + i + \\\" ('\\\" + Convert.ToString(inputs[i][\\\"Name\\\"]) + \\\"') could not be converted to \\\" + Convert.ToString(inputs[i][\\\"Type\\\"]) + \\\".\\\");\\n            }\\n        }\\n        // Ask the dispatcher to return failures, then apply the caller's error mode at the end.\\n        stage = \\\"Dispatch\\\";\\n        var call = UseCall(() => ThisLib.Get(\\\"Return\\\"));\\n        dispatched = true;\\n        var result = call.Run(iLibrary, iFunction, arguments);\\n        oDetails = result.Details;\\n        if (result.Success && result.Outputs.Length == outputs.Length)\\n        {\\n            // Give REST callers both the output position and its declared name.\\n            for (var i = 0; i < outputs.Length; i++)\\n                outputTable.Rows.Add(i, Convert.ToString(outputs[i][\\\"Name\\\"]), result.Outputs[i] ?? DBNull.Value);\\n            oSuccess = true;\\n        }\\n        else if (result.Success)\\n        {\\n            // The target ran. A changed signature must not trigger a second execution.\\n            Failure(oDetails, \\\"Failed\\\", \\\"InvalidResponse\\\", \\\"The output count does not match the current Function signature. The call was not repeated.\\\");\\n        }\\n    }\\n}\\ncatch (Exception error)\\n{\\n    var row = oDetails.Tables[\\\"Call\\\"].Rows[0];\\n    row[\\\"Stage\\\"] = stage;\\n    row[\\\"DispatchStarted\\\"] = dispatched ? (object)DBNull.Value : false;\\n    var code = stage == \\\"Lookup\\\" ? \\\"SignatureUnavailable\\\" :\\n        stage == \\\"Bind\\\" ? \\\"InvalidArgument\\\" :\\n        stage == \\\"Validate\\\" ? \\\"InvalidRequest\\\" : \\\"OutcomeUnknown\\\";\\n    var message = error is System.Text.Json.JsonException\\n        ? \\\"Arguments are not valid JSON.\\\"\\n        : error.Message;\\n    Failure(oDetails, dispatched ? \\\"Unknown\\\" : \\\"NotStarted\\\", code, message);\\n    outputTable.Clear();\\n    oSuccess = false;\\n}\\nwatch.Stop();\\noDetails.Tables[\\\"Call\\\"].Rows[0][\\\"ElapsedMilliseconds\\\"] = watch.ElapsedMilliseconds;\\nif (!oSuccess && throwErrors) RaiseFailure(oDetails);\\n\", \"Usings\": \"using System;\\nusing System.Data;\\nusing System.Collections.Generic;\\nusing System.Linq;\"}"},{"FunctionID":"ReadSignature","Description":"Read one Function signature and status with an unsaved query.","Kind":2,"RequireTransaction":false,"SingleRowMode":false,"Private":true,"Disabled":false,"Invalid":false,"Thumbnail":null,"Notes":"Read one Function signature and status with an unsaved query.","FunctionSignature":[{"Response":false,"ParameterID":1,"ArgumentName":"iLibrary","Order":1,"DataType":"System.String","Optional":false,"Description":""},{"Response":false,"ParameterID":2,"ArgumentName":"iFunction","Order":2,"DataType":"System.String","Optional":false,"Description":""},{"Response":true,"ParameterID":1,"ArgumentName":"oSignature","Order":1,"DataType":"System.Data.DataSet","Optional":false,"Description":""}],"Body":"{\"Code\": \"// Copyright (c) 2026 Kevin P. Lincecum\\n// SPDX-License-Identifier: MIT\\n\\n// Read the target input and output definitions with an unsaved, in-memory BAQ.\\n// Status is metadata, not an admission filter. Native invocation enforces access.\\nvar query = Newtonsoft.Json.JsonConvert.DeserializeObject<Ice.Tablesets.DynamicQueryTableset>(@\\\"{\\\"\\\"DynamicQuery\\\"\\\":[{\\\"\\\"Company\\\"\\\":\\\"\\\"\\\"\\\",\\\"\\\"QueryID\\\"\\\":\\\"\\\"CallSignature\\\"\\\",\\\"\\\"IsShared\\\"\\\":false,\\\"\\\"XCompany\\\"\\\":false,\\\"\\\"Updatable\\\"\\\":false,\\\"\\\"ExtQuery\\\"\\\":false,\\\"\\\"ExtDatasourceName\\\"\\\":\\\"\\\"\\\"\\\",\\\"\\\"SystemFlag\\\"\\\":false,\\\"\\\"AllCompanies\\\"\\\":false,\\\"\\\"UseLiveDB\\\"\\\":false}],\\\"\\\"QuerySubQuery\\\"\\\":[{\\\"\\\"Company\\\"\\\":\\\"\\\"\\\"\\\",\\\"\\\"QueryID\\\"\\\":\\\"\\\"CallSignature\\\"\\\",\\\"\\\"SubQueryID\\\"\\\":\\\"\\\"98778661-13e6-4210-b290-d834e6c4ecdc\\\"\\\",\\\"\\\"Name\\\"\\\":\\\"\\\"Main\\\"\\\",\\\"\\\"Type\\\"\\\":\\\"\\\"TopLevel\\\"\\\",\\\"\\\"Seq\\\"\\\":1,\\\"\\\"IsUnion\\\"\\\":false,\\\"\\\"LeftP\\\"\\\":\\\"\\\"\\\"\\\",\\\"\\\"RightP\\\"\\\":\\\"\\\"\\\"\\\",\\\"\\\"SelectListClause\\\"\\\":\\\"\\\"\\\"\\\",\\\"\\\"TopRowExpr\\\"\\\":0,\\\"\\\"TopInPercent\\\"\\\":false,\\\"\\\"TopWithTies\\\"\\\":false,\\\"\\\"OrderByOffSet\\\"\\\":\\\"\\\"\\\"\\\",\\\"\\\"OrderByFetch\\\"\\\":\\\"\\\"\\\"\\\"}],\\\"\\\"QueryRelation\\\"\\\":[{\\\"\\\"Company\\\"\\\":\\\"\\\"\\\"\\\",\\\"\\\"QueryID\\\"\\\":\\\"\\\"CallSignature\\\"\\\",\\\"\\\"SubQueryID\\\"\\\":\\\"\\\"98778661-13e6-4210-b290-d834e6c4ecdc\\\"\\\",\\\"\\\"RelationID\\\"\\\":\\\"\\\"a8c26400-d65e-446d-8edf-4cd3ee6d8886\\\"\\\",\\\"\\\"IsFK\\\"\\\":false,\\\"\\\"ParentTableID\\\"\\\":\\\"\\\"l\\\"\\\",\\\"\\\"ChildTableID\\\"\\\":\\\"\\\"m\\\"\\\",\\\"\\\"JoinType\\\"\\\":\\\"\\\"LeftOuter\\\"\\\",\\\"\\\"OuterJoin\\\"\\\":false},{\\\"\\\"Company\\\"\\\":\\\"\\\"\\\"\\\",\\\"\\\"QueryID\\\"\\\":\\\"\\\"CallSignature\\\"\\\",\\\"\\\"SubQueryID\\\"\\\":\\\"\\\"98778661-13e6-4210-b290-d834e6c4ecdc\\\"\\\",\\\"\\\"RelationID\\\"\\\":\\\"\\\"4a27a8c8-581d-4618-8c38-52a5170d546d\\\"\\\",\\\"\\\"IsFK\\\"\\\":false,\\\"\\\"ParentTableID\\\"\\\":\\\"\\\"l\\\"\\\",\\\"\\\"ChildTableID\\\"\\\":\\\"\\\"f\\\"\\\",\\\"\\\"JoinType\\\"\\\":\\\"\\\"LeftOuter\\\"\\\",\\\"\\\"OuterJoin\\\"\\\":false},{\\\"\\\"Company\\\"\\\":\\\"\\\"\\\"\\\",\\\"\\\"QueryID\\\"\\\":\\\"\\\"CallSignature\\\"\\\",\\\"\\\"SubQueryID\\\"\\\":\\\"\\\"98778661-13e6-4210-b290-d834e6c4ecdc\\\"\\\",\\\"\\\"RelationID\\\"\\\":\\\"\\\"01251bfd-e621-4209-b9dc-c02d878d9838\\\"\\\",\\\"\\\"IsFK\\\"\\\":false,\\\"\\\"ParentTableID\\\"\\\":\\\"\\\"f\\\"\\\",\\\"\\\"ChildTableID\\\"\\\":\\\"\\\"s\\\"\\\",\\\"\\\"JoinType\\\"\\\":\\\"\\\"LeftOuter\\\"\\\",\\\"\\\"OuterJoin\\\"\\\":false}],\\\"\\\"QueryRelationField\\\"\\\":[{\\\"\\\"Company\\\"\\\":\\\"\\\"\\\"\\\",\\\"\\\"QueryID\\\"\\\":\\\"\\\"CallSignature\\\"\\\",\\\"\\\"SubQueryID\\\"\\\":\\\"\\\"98778661-13e6-4210-b290-d834e6c4ecdc\\\"\\\",\\\"\\\"RelationID\\\"\\\":\\\"\\\"a8c26400-d65e-446d-8edf-4cd3ee6d8886\\\"\\\",\\\"\\\"Seq\\\"\\\":1,\\\"\\\"ParentFieldName\\\"\\\":\\\"\\\"LibraryID\\\"\\\",\\\"\\\"ParentFieldDataType\\\"\\\":\\\"\\\"nvarchar\\\"\\\",\\\"\\\"ParentFieldIsExpr\\\"\\\":false,\\\"\\\"ChildFieldName\\\"\\\":\\\"\\\"LibraryID\\\"\\\",\\\"\\\"ChildFieldDataType\\\"\\\":\\\"\\\"nvarchar\\\"\\\",\\\"\\\"ChildFieldIsExpr\\\"\\\":false,\\\"\\\"AndOr\\\"\\\":\\\"\\\"\\\"\\\",\\\"\\\"Neg\\\"\\\":false,\\\"\\\"LeftP\\\"\\\":\\\"\\\"\\\"\\\",\\\"\\\"RightP\\\"\\\":\\\"\\\"\\\"\\\",\\\"\\\"CompOp\\\"\\\":\\\"\\\"=\\\"\\\"},{\\\"\\\"Company\\\"\\\":\\\"\\\"\\\"\\\",\\\"\\\"QueryID\\\"\\\":\\\"\\\"CallSignature\\\"\\\",\\\"\\\"SubQueryID\\\"\\\":\\\"\\\"98778661-13e6-4210-b290-d834e6c4ecdc\\\"\\\",\\\"\\\"RelationID\\\"\\\":\\\"\\\"4a27a8c8-581d-4618-8c38-52a5170d546d\\\"\\\",\\\"\\\"Seq\\\"\\\":1,\\\"\\\"ParentFieldName\\\"\\\":\\\"\\\"LibraryID\\\"\\\",\\\"\\\"ParentFieldDataType\\\"\\\":\\\"\\\"nvarchar\\\"\\\",\\\"\\\"ParentFieldIsExpr\\\"\\\":false,\\\"\\\"ChildFieldName\\\"\\\":\\\"\\\"LibraryID\\\"\\\",\\\"\\\"ChildFieldDataType\\\"\\\":\\\"\\\"nvarchar\\\"\\\",\\\"\\\"ChildFieldIsExpr\\\"\\\":false,\\\"\\\"AndOr\\\"\\\":\\\"\\\"\\\"\\\",\\\"\\\"Neg\\\"\\\":false,\\\"\\\"LeftP\\\"\\\":\\\"\\\"\\\"\\\",\\\"\\\"RightP\\\"\\\":\\\"\\\"\\\"\\\",\\\"\\\"CompOp\\\"\\\":\\\"\\\"=\\\"\\\"},{\\\"\\\"Company\\\"\\\":\\\"\\\"\\\"\\\",\\\"\\\"QueryID\\\"\\\":\\\"\\\"CallSignature\\\"\\\",\\\"\\\"SubQueryID\\\"\\\":\\\"\\\"98778661-13e6-4210-b290-d834e6c4ecdc\\\"\\\",\\\"\\\"RelationID\\\"\\\":\\\"\\\"01251bfd-e621-4209-b9dc-c02d878d9838\\\"\\\",\\\"\\\"Seq\\\"\\\":1,\\\"\\\"ParentFieldName\\\"\\\":\\\"\\\"LibraryID\\\"\\\",\\\"\\\"ParentFieldData